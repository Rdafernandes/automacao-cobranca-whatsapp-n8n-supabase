                      "parameters":  {
                                         "jsCode":  "const body = $json.body ?? $json;\nconst msg = body.messages?.[0] ?? body.message ?? body;\n\nfunction pick(...vals) {\n  return vals.find(v =\u003e v !== undefined \u0026\u0026 v !== null \u0026\u0026 String(v).trim() !== \u0027\u0027);\n}\n\nfunction digits(v) {\n  const d = String(v ?? \u0027\u0027).replace(/\\D/g, \u0027\u0027);\n  if (!d) return null;\n  if (d.startsWith(\u002755\u0027) \u0026\u0026 (d.length === 12 || d.length === 13)) return d;\n  if (d.length === 10 || d.length === 11) return `55${d}`;\n  return d;\n}\n\nconst chatId = pick(\n  msg.chat_id,\n  msg.chatId,\n  msg.chat?.id,\n  msg.from,\n  body.chat_id\n);\n\nconst messageId = pick(\n  msg.id,\n  msg.message_id,\n  msg.key?.id,\n  body.id\n);\n\nconst fromMe = Boolean(\n  msg.from_me === true ||\n  msg.fromMe === true ||\n  msg.key?.fromMe === true\n);\n\nconst type = String(pick(msg.type, msg.message_type, msg.event?.type, \u0027\u0027) || \u0027\u0027).toLowerCase();\n\nconst senderRaw = pick(\n  msg.from,\n  msg.sender,\n  msg.participant,\n  msg.author,\n  msg.contact?.id,\n  chatId\n);\n\nconst isGroup = String(chatId || \u0027\u0027).includes(\u0027@g.us\u0027);\nconst isPrivate =\n  String(chatId || \u0027\u0027).includes(\u0027@s.whatsapp.net\u0027) ||\n  String(chatId || \u0027\u0027).includes(\u0027@c.us\u0027) ||\n  (!isGroup \u0026\u0026 digits(senderRaw));\n\nconst textBody = pick(\n  msg.text?.body,\n  msg.text,\n  msg.body,\n  msg.message?.conversation,\n  msg.caption,\n  msg.image?.caption,\n  msg.video?.caption,\n  msg.document?.caption,\n  \u0027\u0027\n);\n\nconst documentObj = msg.document ?? msg.file ?? msg.media ?? {};\nconst imageObj = msg.image ?? {};\nconst audioObj = msg.audio ?? msg.voice ?? {};\nconst videoObj = msg.video ?? {};\n\nconst filename = String(pick(\n  documentObj.file_name,\n  documentObj.filename,\n  documentObj.name,\n  msg.filename,\n  msg.file_name,\n  \u0027\u0027\n) || \u0027\u0027);\n\nconst mimeType = String(pick(\n  documentObj.mime_type,\n  documentObj.mimetype,\n  documentObj.mimeType,\n\n  imageObj.mime_type,\n  imageObj.mimetype,\n  imageObj.mimeType,\n\n  audioObj.mime_type,\n  audioObj.mimetype,\n  audioObj.mimeType,\n\n  videoObj.mime_type,\n  videoObj.mimetype,\n  videoObj.mimeType,\n\n  msg.media?.mime_type,\n  msg.media?.mimetype,\n  msg.media?.mimeType,\n\n  msg.file?.mime_type,\n  msg.file?.mimetype,\n  msg.file?.mimeType,\n\n  msg.mime_type,\n  msg.mimetype,\n  msg.mimeType,\n  \u0027\u0027\n) || \u0027\u0027).toLowerCase();\n\nconst isPdf = mimeType.includes(\u0027pdf\u0027) || filename.toLowerCase().endsWith(\u0027.pdf\u0027);\n\nconst isPdfOs =\n  isPdf \u0026\u0026\n  (\n    /ordem[\\s_-]*de[\\s_-]*serv/i.test(filename) ||\n    /ordem.*servi/i.test(filename) ||\n    /^os[\\s_-]?\\d+.*\\.pdf$/i.test(filename)\n  );\n\nlet permitido_payload = true;\nlet motivo_bloqueio = null;\n\nif (fromMe) {\n  permitido_payload = false;\n  motivo_bloqueio = \u0027from_me\u0027;\n} else if (isGroup) {\n  permitido_payload = false;\n  motivo_bloqueio = \u0027grupo\u0027;\n} else if (!isPrivate) {\n  permitido_payload = false;\n  motivo_bloqueio = \u0027nao_dm_privada\u0027;\n} else if (isPdfOs) {\n  permitido_payload = false;\n  motivo_bloqueio = \u0027pdf_ordem_servico\u0027;\n}\n\nreturn [{\n  json: {\n    permitido_payload,\n    motivo_bloqueio,\n\n    whapi: {\n      message_id: messageId,\n      chat_id: chatId,\n      from_me: fromMe,\n      type,\n      sender_raw: senderRaw,\n      sender_whatsapp_norm: digits(senderRaw),\n      text_body: textBody,\n      filename,\n      mime_type: mimeType,\n      is_pdf: isPdf,\n      is_pdf_os: isPdfOs,\n\n      media: {\n        id: pick(\n          documentObj.id,\n          imageObj.id,\n          audioObj.id,\n          videoObj.id,\n          msg.media?.id,\n          msg.file?.id\n        ),\n        url: pick(\n          documentObj.link,\n          documentObj.url,\n          documentObj.download_url,\n          documentObj.downloadUrl,\n          imageObj.link,\n          imageObj.url,\n          imageObj.download_url,\n          imageObj.downloadUrl,\n          audioObj.link,\n          audioObj.url,\n          audioObj.download_url,\n          audioObj.downloadUrl,\n          videoObj.link,\n          videoObj.url,\n          videoObj.download_url,\n          videoObj.downloadUrl,\n          msg.media?.link,\n          msg.media?.url,\n          msg.file?.link,\n          msg.file?.url\n        ),\n        filename,\n        mime_type: mimeType,\n        caption: textBody\n      },\n\n      raw_payload: body\n    }\n  }\n}];"
