                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "const base = $node[\"Montar mensagem cobrança cliente\"].json;\nconst whapi = $node[\"WHAPI | Enviar cobrança cliente\"].json;\nconst rpc = $json;\n\nconst formatBRL = (centavos) =\u003e {\n  return (Number(centavos ?? 0) / 100).toLocaleString(\u0027pt-BR\u0027, {\n    style: \u0027currency\u0027,\n    currency: \u0027BRL\u0027\n  });\n};\n\nconst mensagem = [\n  \u0027[Cobrança enviada] *Cobrança enviada ao cliente*\u0027,\n  \u0027\u0027,\n  `*Cliente:* ${base.cliente_nome_fantasia ?? base.cliente_razao_social ?? \u0027-\u0027}`,\n  `*Contato:* ${base.contato_nome ?? \u0027-\u0027}`,\n  `*WhatsApp:* ${base.contato_whatsapp_norm ?? \u0027-\u0027}`,\n  \u0027\u0027,\n  `*Pendências:* ${base.cobranca_envio.qtd_pendencias}`,\n  `*Total:* ${formatBRL(base.cobranca_envio.total_centavos)}`,\n  `*Dias atraso:* ${base.cobranca_envio.dias_atraso}`,\n  `*Tentativas anteriores:* ${base.cobranca_envio.tentativas_cobranca}`\n].join(\u0027\\n\u0027);\n\nreturn {\n  json: {\n    ...base,\n    alerta_interno: {\n      mensagem,\n      whatsapp_message_id: whapi.message?.id ?? null,\n      rpc_result: rpc\n    }\n  }\n};"
