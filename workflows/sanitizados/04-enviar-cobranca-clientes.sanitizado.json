                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "function formatBRL(centavos) {\n  if (centavos === null || centavos === undefined) return \u0027-\u0027;\n\n  return (Number(centavos) / 100).toLocaleString(\u0027pt-BR\u0027, {\n    style: \u0027currency\u0027,\n    currency: \u0027BRL\u0027\n  });\n}\n\nfunction formatDateBR(dateStr) {\n  if (!dateStr) return \u0027-\u0027;\n\n  const [yyyy, mm, dd] = String(dateStr).split(\u0027T\u0027)[0].split(\u0027-\u0027);\n\n  if (!yyyy || !mm || !dd) return dateStr;\n\n  return `${dd}/${mm}/${yyyy}`;\n}\n\nfunction primeiroNome(nome) {\n  const clean = String(nome ?? \u0027\u0027).trim();\n  if (!clean) return \u0027\u0027;\n  return clean.split(/\\s+/)[0];\n}\n\nfunction saudacaoAtual() {\n  const hora = new Date().getHours();\n\n  if (hora \u003e= 5 \u0026\u0026 hora \u003c= 11) return \u0027Bom dia\u0027;\n  if (hora \u003e= 12 \u0026\u0026 hora \u003c= 17) return \u0027Boa tarde\u0027;\n\n  return \u0027Boa noite\u0027;\n}\n\nconst pendencias = Array.isArray($json.pendencias_json)\n  ? $json.pendencias_json\n  : [];\n\nif (!pendencias.length) {\n  throw new Error(\u0027Contato sem pendencias_json.\u0027);\n}\n\nconst diasAtraso = Number($json.maior_dias_atraso ?? 0);\nconst tentativas = Number($json.maior_tentativas_cobranca ?? 0);\n\nlet tipoMensagem = \u0027amigavel\u0027;\n\nif (diasAtraso \u003e= 15) {\n  tipoMensagem = \u0027firme\u0027;\n} else if (diasAtraso \u003e= 6) {\n  tipoMensagem = \u0027educada\u0027;\n}\n\nconst pendenciaIds = pendencias\n  .map(p =\u003e p.pendencia_id)\n  .filter(Boolean);\n\nconst total = Number(\n  $json.total_atualizado_centavos ??\n  pendencias.reduce((acc, p) =\u003e {\n    return acc + Number(p.valor_atualizado_centavos ?? p.valor_cobrado_centavos ?? 0);\n  }, 0)\n);\n\nconst linhasOS = pendencias.map(p =\u003e {\n  const valor = p.valor_atualizado_centavos ?? p.valor_cobrado_centavos;\n  return `OS ${p.num_os ?? \u0027-\u0027} - ${formatBRL(valor)} - venc. ${formatDateBR(p.vencimento)}`;\n}).join(\u0027\\n\u0027);\n\nconst qtd = pendencias.length;\nconst nomeContato = primeiroNome($json.contato_nome);\nconst saudacao = nomeContato\n  ? `${saudacaoAtual()}, ${nomeContato}.`\n  : `${saudacaoAtual()}.`;\n\nconst tituloDetalhes = qtd === 1\n  ? \u0027Detalhes da ordem de serviço em aberto:\u0027\n  : \u0027Detalhes das ordens de serviço em aberto:\u0027;\n\nlet corpo;\n\nif (tipoMensagem === \u0027amigavel\u0027) {\n  corpo = qtd === 1\n    ? `Identificamos um valor pendente de ${formatBRL(total)}, referente a uma ordem de serviço com vencimento em ${formatDateBR(pendencias[0].vencimento)}. Pode ter passado despercebido.`\n    : `Identificamos um valor pendente de ${formatBRL(total)}, referente a mais de uma ordem de serviço em aberto, com datas de vencimento diferentes. A mais antiga está em atraso há ${diasAtraso} dias.`;\n\n} else if (tipoMensagem === \u0027educada\u0027) {\n  corpo = qtd === 1\n    ? `Consta um valor pendente de ${formatBRL(total)}, referente a uma ordem de serviço com vencimento em ${formatDateBR(pendencias[0].vencimento)}. O pagamento está em atraso há ${diasAtraso} dias.`\n    : `Consta um valor pendente de ${formatBRL(total)}, distribuído em mais de uma ordem de serviço, com vencimentos em datas diferentes. A mais antiga está em atraso há ${diasAtraso} dias.`;\n\n} else {\n  corpo = qtd === 1\n    ? `Consta pendente o valor de ${formatBRL(total)}, referente a uma ordem de serviço vencida em ${formatDateBR(pendencias[0].vencimento)}. Como o atraso já é de ${diasAtraso} dias, pedimos prioridade no retorno.`\n    : `Consta pendente o valor total de ${formatBRL(total)}, referente a mais de uma ordem de serviço, com vencimentos em datas diferentes. A mais antiga está em atraso há ${diasAtraso} dias, por isso pedimos prioridade no retorno.`;\n}\n\nlet pedido;\n\nif (tipoMensagem === \u0027amigavel\u0027) {\n  pedido = \u0027Pode nos retornar com a previsão de pagamento ou enviar o comprovante por aqui?\u0027;\n} else if (tipoMensagem === \u0027educada\u0027) {\n  pedido = \u0027Por gentileza, nos retorne com uma previsão de pagamento ou informe se precisa de segunda via ou mais detalhes.\u0027;\n} else {\n  pedido = \u0027Solicitamos, por gentileza, um retorno com a previsão de pagamento ou o envio do comprovante, caso o pagamento já tenha sido realizado.\u0027;\n}\n\nconst encerramento = \u0027Se o pagamento já foi realizado, por gentileza, desconsidere esta mensagem.\u0027;\n\nconst mensagem = [\n  saudacao,\n  \u0027\u0027,\n  corpo,\n  \u0027\u0027,\n  pedido,\n  encerramento,\n  \u0027\u0027,\n  tituloDetalhes,\n  linhasOS\n].join(\u0027\\n\u0027);\n\nreturn {\n  json: {\n    ...$json,\n    cobranca_envio: {\n      to: $json.contato_whatsapp_norm,\n      mensagem,\n      pendencia_ids: pendenciaIds,\n      total_centavos: total,\n      qtd_pendencias: qtd,\n      dias_atraso: diasAtraso,\n      tentativas_cobranca: tentativas,\n      tipo_mensagem: tipoMensagem,\n      tom_cobranca: $json.tom_cobranca ?? null\n    }\n  }\n};"
                                     },
