                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "function formatBRL(centavos) {\n  if (centavos === null || centavos === undefined) return \u0027-\u0027;\n\n  return (Number(centavos) / 100).toLocaleString(\u0027pt-BR\u0027, {\n    style: \u0027currency\u0027,\n    currency: \u0027BRL\u0027\n  });\n}\n\nfunction shortText(text, max = 160) {\n  const clean = String(text ?? \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n  if (!clean) return \u0027-\u0027;\n  return clean.length \u003e max ? `${clean.slice(0, max - 1)}...` : clean;\n}\n\nconst pendencias = Array.isArray($json.pendencias_abertas_json)\n  ? $json.pendencias_abertas_json\n  : [];\n\nconst comprovantes = Array.isArray($json.comprovantes_json)\n  ? $json.comprovantes_json\n  : [];\n\nconst comp = comprovantes[0] ?? null;\n\nconst linhasPendencias = pendencias.length\n  ? pendencias.map(p =\u003e {\n      const valor = p.valor_atualizado_centavos ?? p.valor_cobrado_centavos;\n      return `- OS ${p.num_os ?? \u0027-\u0027} | ${formatBRL(valor)} | ${p.status_cobranca ?? \u0027-\u0027}`;\n    }).join(\u0027\\n\u0027)\n  : \u0027- Nenhuma OS pendente encontrada.\u0027;\n\nlet mensagem;\n\nif ($json.categoria === \u0027comprovante\u0027 || comp) {\n  const pend = comp\n    ? pendencias.find(p =\u003e p.pendencia_id === comp.pendencia_id) ?? pendencias[0]\n    : pendencias[0];\n\n  const valorPendente = pend\n    ? (pend.valor_atualizado_centavos ?? pend.valor_cobrado_centavos)\n    : null;\n\n  const valorComprovante = comp?.valor_extraido_centavos ?? null;\n\n  const diferenca = (\n    valorPendente !== null \u0026\u0026\n    valorPendente !== undefined \u0026\u0026\n    valorComprovante !== null \u0026\u0026\n    valorComprovante !== undefined\n  )\n    ? valorComprovante - valorPendente\n    : null;\n\n  const linhaDiferenca =\n    diferenca === null\n      ? \u0027Atenção: Conferir valor manualmente\u0027\n      : diferenca === 0\n        ? \u0027OK: Valor bate com a pendência\u0027\n        : `Atenção: Diferença ${formatBRL(diferenca)}`;\n\n  mensagem = [\n    \u0027[Comprovante recebido] *Comprovante recebido*\u0027,\n    \u0027\u0027,\n    `*Cliente:* ${$json.cliente_nome_fantasia ?? $json.cliente_razao_social ?? \u0027-\u0027}`,\n    `*Contato:* ${$json.contato_nome ?? \u0027-\u0027}`,\n    \u0027\u0027,\n    `*OS:* ${pend?.num_os ?? \u0027-\u0027}`,\n    `*Pendente:* ${formatBRL(valorPendente)}`,\n    `*Comprovante:* ${formatBRL(valorComprovante)}`,\n    linhaDiferenca,\n    \u0027\u0027,\n    `*Arquivo:* ${comp?.arquivo_url ?? $json.anexo_url ?? \u0027-\u0027}`\n  ].join(\u0027\\n\u0027);\n\n} else {\n  mensagem = [\n    \u0027[Resposta cobrança] *Resposta cobrança*\u0027,\n    \u0027\u0027,\n    `*Cliente:* ${$json.cliente_nome_fantasia ?? $json.cliente_razao_social ?? \u0027-\u0027}`,\n    `*Contato:* ${$json.contato_nome ?? \u0027-\u0027}`,\n    `*Msg:* ${shortText($json.mensagem, 160)}`,\n    \u0027\u0027,\n    \u0027*Pendências:*\u0027,\n    linhasPendencias\n  ].join(\u0027\\n\u0027);\n}\n\nreturn {\n  json: {\n    ...$json,\n    notificacao: {\n      mensagem,\n      interacao_ids: [$json.interacao_id]\n    }\n  }\n};"
                                     },
